# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgres://solgrid:solgrid@localhost:5432/solgrid

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Solana ─────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# The deployer wallet — used by `anchor deploy` and by sol-client when
# CLIENT_KEYPAIR_PATH is unset. The standard Solana CLI keypair location.
AUTHORITY_KEYPAIR_PATH=~/.config/solana/id.json

# The verifier authority — signs `submit_receipt` and `release_escrow`
# on-chain. Created by `scripts/setup-devnet.sh`.
VERIFIER_KEYPAIR_PATH=./data/verifier-keypair.json

# The mock GPU provider's wallet. Generated on first run by sol-agent if
# it does not exist.
AGENT_KEYPAIR_PATH=./data/agent-keypair.json

# ─── Anchor Program IDs ─────────────────────────────────────────────
# Populated by `scripts/setup-devnet.sh` after `anchor deploy`.
PROVIDER_REGISTRY_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS
JOB_ESCROW_PROGRAM_ID=HmbTLCmaGtYhSsT3D2RzKFkN3CKqZbHN4KxrFEhMccgH
COMPUTE_RECEIPTS_PROGRAM_ID=9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM

# ─── Settlement Token ───────────────────────────────────────────────
# Use a tSIMD ("test SIMD") mint on devnet. Created by sol-client setup-mint.
GRID_TOKEN_MINT=11111111111111111111111111111111
GRID_TOKEN_DECIMALS=6

# ─── Service Ports / URLs ───────────────────────────────────────────
SCHEDULER_PORT=8080
VERIFIER_PORT=8081
SCHEDULER_URL=http://localhost:8080
VERIFIER_URL=http://localhost:8081
